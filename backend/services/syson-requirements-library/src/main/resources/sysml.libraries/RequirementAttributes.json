mentId":"5069424c-4f79-4fcc-9152-2f3c150f2ab4","type":"sysml:DataType kermllibrary:///b2c6dd37-2084-3ce4-9ce2-580fdf30629c#76028d3d-69a4-5e12-9002-ce403e0244bd","typedFeature":"5fa0a98a-fbfb-41dc-b454-180c268744b0"}}],"isComposite":true}}]}},{"id":"edccbf91-4319-4200-9000-d44b7bc868b7","eClass":"sysml:FeatureMembership","data":{"elementId":"82896cab-5c1c-496f-8545-9e687dae1806","ownedRelatedElement":[{"id":"e8072d6f-8abc-4c0f-a057-8733e7fed124","eClass":"sysml:ReferenceUsage","data":{"elementId":"06641bf3-ed72-4803-a51f-09825d15ee9f","ownedRelationship":[{"id":"34a18f5e-dc8d-48bd-b5f4-eff558373243","eClass":"sysml:Subsetting","data":{"elementId":"4ea9838c-9c45-47d6-b165-16cb816f9336","subsettedFeature":"sysml:Feature kermllibrary:///eed035b6-25dc-32cd-8fdf-233aa595e17a#619988f5-49d9-5c7e-9785-f3edd5b4d3fd","subsettingFeature":"06641bf3-ed72-4803-a51f-09825d15ee9f"}},{"id":"3c110472-0440-4800-a3dc-be303f622003","eClass":"sysml:FeatureTyping","data":{"elementId":"f2ca6974-9d37-4e20-b6fb-8aa95ad99ee5","type":"sysml:MetadataDefinition sysmllibrary:///389615e8-f636-3405-928f-411d874ba837#e4cd605b-282e-5367-9ef2-5ffa1685c67b","typedFeature":"06641bf3-ed72-4803-a51f-09825d15ee9f"}}],"isComposite":true}}]}}]}}]}},{"id":"7ba04903-0f39-4f93-9848-4ec8ad70f5ca","eClass":"sysml:OwningMembership","data":{"elementId":"c1a7adfa-5b6d-4734-bd1e-1cbdf7cd719a","ownedRelatedElement":[{"id":"f59a84e4-31df-4c7b-a6c5-26bd478bb60e","eClass":"sysml:MetadataDefinition","data":{"declaredName":"RequirementIdSequence","elementId":"4cb0d7dd-1709-4ecc-b6c0-1d18d12b631c","ownedRelationship":[{"id":"d1f6bf2d-cb60-4dc7-b270-319c91263733","eClass":"sysml:OwningMembership","data":{"elementId":"a11fd32c-a977-40fa-8a00-fa8afd315f1a","ownedRelatedElement":[{"id":"a1799aaf-1008-4abb-a44d-3a99afa59ca2","eClass":"sysml:Documentation","data":{"elementId":"b8db2c77-3a38-4ade-9a44-3e167998a36c","body":"* Carries the auto-assignment state for the requirements tables \"Create Requirement\"\n         * tool: a user-settable ID prefix (e.g. \"SYS-\") and the next number to assign (e.g.\n         * 12, to produce \"SYS-012\"). Applied on the requirements tables own owning namespace\n         * (typically a Package), not on individual requirements -- one sequence per table.\n         *\n         * nextNumber is a monotonically-increasing counter, not derived from scanning existing\n         * reqIds: deleting the highest-numbered requirement must not free its number for reuse.\n         * RTVMutationServices increments it by mutating the LiteralInteger value in place after\n         * assigning nextNumbers current value, rather than reimporting the whole metadata.\n         *\n         * Unrestricted (no \":> annotatedElement\" restriction), same reasoning as\n         * OperationalConcept in syson-operational-concept-library: Package/Namespace are not\n         * reflectively exposed as metaclasses anywhere in the bundled standard library, so\n         * there is no SysML::Package to restrict against.\n         *\n         * To use a different prefix than the default (\"REQ-\"), apply this metadata by hand\n         * (e.g. \"@RequirementAttributesLibrary::RequirementIdSequence { prefix = \"SYS-\";\n         * nextNumber = 1; }\") on the tables owning package before creating the first\n         * requirement through the table -- this project does not (yet) provide a dedicated\n         * settings UI for it, matching this librarys minimal-new-UI stance elsewhere."}}]}},{"id":"75dcd1d6-f7e4-4ab8-8afc-b6451bec6598","eClass":"sysml:FeatureMembership","data":{"elementId":"ca45ebcb-821c-400d-bf03-57a9466d8fa6","ownedRelatedElement":[{"id":"731e42e9-8051-42df-b177-10234da8473c","eClass":"sysml:AttributeUsage","data":{"declaredName":"prefix","elementId":"69566445-7f3d-4502-87b1-08b9cae50b50","ownedRelationship":[{"id":"e7e1843f-8aa0-4823-ac9a-ab199f721429","eClass":"sysml:FeatureTyping","data":{"elementId":"b9bf9fb5-5541-4bc7-9ed8-ffff7e4b8664","type":"sysml:DataType kermllibrary:///b