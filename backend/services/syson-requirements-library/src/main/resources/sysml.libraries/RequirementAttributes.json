{"json":{"version":"1.0","encoding":"utf-8"},"ns":{"sysml":"http://www.eclipse.org/syson/sysml"},"content":[{"id":"39ad3d0e-72b7-4c62-92be-34eedca44f19","eClass":"sysml:Namespace","data":{"elementId":"b1c6645f-7526-4cca-9a57-d639072757de","ownedRelationship":[{"id":"063c1263-bf38-4f0c-b459-3b01908ce509","eClass":"sysml:OwningMembership","data":{"elementId":"d491baa3-aedf-4d6e-949b-997273e1c58c","ownedRelatedElement":[{"id":"7ae3d6a4-60dc-40ed-b1e1-8987d4d9863a","eClass":"sysml:LibraryPackage","data":{"declaredName":"RequirementAttributesLibrary","elementId":"86bf499a-e09f-43cb-8acc-34e62cb8ec06","ownedRelationship":[{"id":"44453277-ab32-4f79-bee7-22902936cbb5","eClass":"sysml:OwningMembership","data":{"elementId":"b1af3259-2d48-433e-8802-1369fb8310c2","ownedRelatedElement":[{"id":"9decf411-18b2-415e-941f-41fa5ed1a021","eClass":"sysml:Documentation","data":{"elementId":"ff048fdb-8ee5-4d58-bd26-1fe978028359","body":"* SysON project addition to the SysML v2 standard library.\n     *\n     * Adds two requirement-table concepts that have no standard SysML v2 equivalent (checked:\n     * neither \"Threshold or Objective\" nor a free-text \"Category\" appear anywhere in the 90\n     * files that make up the bundled standard library). \"Requirement Type\" (Functional,\n     * Interface, Performance, Physical, Design Constraint), by contrast, does not need\n     * anything from this library: it is modeled by specializing the standard librarys own\n     * Requirements::FunctionalRequirementCheck / InterfaceRequirementCheck /\n     * PerformanceRequirementCheck / PhysicalRequirementCheck / DesignConstraintCheck\n     * RequirementDefinitions -- see RTVRequirementTypeMappings Javadoc in\n     * syson-table-requirements-view.\n     *\n     * This file is the canonical, human-authored source of truth. It is not loaded\n     * directly at runtime: it is compiled into ../sysml.libraries/RequirementAttributes.json\n     * by RequirementAttributesLibraryGenerator (see src/test/java), which is re-run by hand\n     * whenever this file changes. See this modules README.md for details."}}]}},{"id":"adca6057-70c2-44c5-9f3f-bcc2b95a7df5","eClass":"sysml:MembershipImport","data":{"elementId":"6dd6cd56-95d7-4302-b468-05823a94f6e5","importedMembership":"sysml:OwningMembership kermllibrary:///b2c6dd37-2084-3ce4-9ce2-580fdf30629c#f7bb3149-834c-5a36-bbed-335b2a37b3fe"}},{"id":"2293428e-f77b-457a-885f-eb2270b9e0e4","eClass":"sysml:MembershipImport","data":{"elementId":"65fc7378-42b8-4e66-88e4-e30129130cba","importedMembership":"sysml:OwningMembership kermllibrary:///b2c6dd37-2084-3ce4-9ce2-580fdf30629c#5fe9f6f1-ce05-5285-b333-41374fe9f447"}},{"id":"d4439536-8ad5-40e8-8131-791b3cfad526","eClass":"sysml:OwningMembership","data":{"elementId":"bf45a278-ff35-4540-a442-5f38d12f7afc","ownedRelatedElement":[{"id":"a9cd10ba-43ab-48fc-aec1-ea76ef59b530","eClass":"sysml:EnumerationDefinition","data":{"declaredName":"ThresholdOrObjectiveKind","elementId":"2a1d1bdc-78b4-4496-9d63-4cda01bed07d","ownedRelationship":[{"id":"45c30ce1-2e54-45c5-80bc-cf7c35db4c0b","eClass":"sysml:OwningMembership","data":{"elementId":"944c2649-d546-4760-b03c-8db9f38d230e","ownedRelatedElement":[{"id":"d7cb54e0-578e-4e28-bd72-5dff4e3d2d88","eClass":"sysml:Documentation","data":{"elementId":"12102277-1f99-441e-8967-1752b60e169e","body":"* Whether a quantitative requirement value is the minimally-acceptable bound\n         * (threshold) or the desired, better-than-minimum target (objective) -- the standard\n         * measure-of-effectiveness/KPP framing used across systems engineering requirements\n         * tables, with no equivalent already in the SysML v2 standard library."}}]}},{"id":"fc6417c2-4cf5-420e-950e-73145c2346b3","eClass":"sysml:VariantMembership","data":{"elementId":"85764bf5-f974-4f9e-aadb-d73f89ef46ae","ownedRelatedElement":[{"id":"a14a3b6e-66cd-48b5-abcd-2f6c205aeb35","eClass":"sysml:EnumerationUsage","data":{"declaredName":"threshold","elementId":"b5ccefe4-a02f-4edd-a34a-a215