{"json":{"version":"1.0","encoding":"utf-8"},"ns":{"sysml":"http://www.eclipse.org/syson/sysml"},"content":[{"id":"6ff1f62d-2751-47d0-96f6-6988ec588a9e","eClass":"sysml:Namespace","data":{"elementId":"12edb732-648d-4362-9602-0b332745e5cf","ownedRelationship":[{"id":"49648d9d-1420-45ca-bbde-1d302ac7314c","eClass":"sysml:OwningMembership","data":{"elementId":"c682e1f3-7f92-477e-aa5f-13cf7466fec2","ownedRelatedElement":[{"id":"932129de-03cd-4092-816f-3aeb66c1e420","eClass":"sysml:LibraryPackage","data":{"declaredName":"VerificationProcedureLibrary","elementId":"d33483dd-ee0d-4867-9dc7-209ac18aaedc","ownedRelationship":[{"id":"76533255-b02c-493b-b0a5-a1e48aeccc75","eClass":"sysml:OwningMembership","data":{"elementId":"eb202b1d-bfe3-4d9f-a81f-e01c85f72287","ownedRelatedElement":[{"id":"00f068ee-54ca-4f9b-ba99-6951e59146d7","eClass":"sysml:Documentation","data":{"elementId":"1a264157-5754-4e95-a482-50563d4c97d5","body":"* SysON project addition to the SysML v2 standard library.\n     *\n     * The standard library (sysml.libraries/VerificationCases.json) already defines\n     * VerificationMethodKind (test/demo/analyze/inspect) and the VerificationMethod\n     * metadata definition that carries it. This library adds only what is missing:\n     * a procedure identifier, meant to be applied on a VerificationCaseUsage alongside\n     * the standard VerificationMethod metadata, not instead of it.\n     *\n     * This file is the canonical, human-authored source of truth. It is not loaded\n     * directly at runtime: it is compiled into ../sysml.libraries/VerificationProcedure.json\n     * by VerificationProcedureLibraryGenerator (see src/test/java), which is re-run by\n     * hand whenever this file changes. See this modules README.md for details."}}]}},{"id":"7189a8f2-591e-4e42-a67f-ebb90fd14203","eClass":"sysml:MembershipImport","data":{"elementId":"dfb20115-3803-4627-9593-416a8c769a8b","importedMembership":"sysml:OwningMembership kermllibrary:///b2c6dd37-2084-3ce4-9ce2-580fdf30629c#f7bb3149-834c-5a36-bbed-335b2a37b3fe"}},{"id":"41d03c85-6926-4a84-9043-23eecabeac51","eClass":"sysml:OwningMembership","data":{"elementId":"9aee738c-3029-4575-a9ea-36e259432942","ownedRelatedElement":[{"id":"ac6beb86-f4b2-4416-b379-0e5060ffc485","eClass":"sysml:MetadataDefinition","data":{"declaredName":"VerificationProcedure","elementId":"25e057fa-b30d-48dc-a68d-fd7a369d28d4","ownedRelationship":[{"id":"698befdc-8c39-4119-832a-5e9f5daa6226","eClass":"sysml:OwningMembership","data":{"elementId":"1febe185-212a-4c58-9254-13579018a10d","ownedRelatedElement":[{"id":"68c3aba0-2d8b-4802-bb6e-aab19d1a8042","eClass":"sysml:Documentation","data":{"elementId":"f606c2c1-f543-4da1-a74d-bb086853c23f","body":"* Identifies the procedure document/section that a verification case executes,\n         * e.g. \"SYS-TP-014\" or \"Section 4.2.1\". Free text: this library does not assume\n         * any particular procedure numbering or document management scheme."}}]}},{"id":"01ebaa6b-54c0-463e-8430-5fea8be9e949","eClass":"sysml:FeatureMembership","data":{"elementId":"644af02d-9f57-4946-8a41-b4b7581b657f","ownedRelatedElement":[{"id":"700b930f-4bab-4fa2-8b3e-cc31c329822a","eClass":"sysml:AttributeUsage","data":{"declaredName":"procedureId","elementId":"eda24830-6a4a-42f7-b981-7f77bda2c0e3","ownedRelationship":[{"id":"15aa47a6-2cb0-43b8-a621-558ce59970ac","eClass":"sysml:FeatureTyping","data":{"elementId":"856e6d89-2cec-465d-9ce2-4966e28f8301","type":"sysml:DataType kermllibrary:///b2c6dd37-2084-3ce4-9ce2-580fdf30629c#76028d3d-69a4-5e12-9002-ce403e0244bd","typedFeature":"eda24830-6a4a-42f7-b981-7f77bda2c0e3"}}],"isComposite":true}}]}},{"id":"2c921b97-0e5b-4c20-af00-0c32f474a06c","eClass":"sysml:FeatureMembership","data":{"elementId":"684f6b79-a9cf-4fae-a84f-fc22733874ac","ownedRelatedElement":[{"id":"144b2fde-2d5a-4f61-bd75-42b04aee6093","eClass":"sysml:ReferenceUsage","data":{"elementId":"77549f73-276d-4a40-805e-6d619a47faac","ownedRelationship":[{"id":"7ad9a172-30f4-4b75-b39f-c1b551392804","eClass":"sysml:Subsetting","data":{"elementId":"c005c3de-bedf-4263-91b4-074ac2dbfb46","subsettedFeature":"sysml:Feature kermllibrary:///eed035b6-25dc-32cd-8fdf-233aa595e17a#619988f5-49d9-5c7e-9785-f3edd5b4d3fd","subsettingFeature":"77549f73-276d-4a40-805e-6d619a47faac"}},{"id":"2d702fa7-6142-419e-92e1-f8b68a422b82","eClass":"sysml:FeatureTyping","data":{"elementId":"064e7d40-f98b-44f2-b12c-f2d93714da74","type":"sysml:MetadataDefinition sysmllibrary:///389615e8-f636-3405-928f-411d874ba837#ff6d99be-c48a-5fe1-b58b-b91a2a336a80","typedFeature":"77549f73-276d-4a40-805e-6d619a47faac"}}],"isComposite":true}}]}}]}}]}},{"id":"9086ae4c-a203-48a0-831f-16c2d675c5d9","eClass":"sysml:OwningMembership","data":{"elementId":"3451ac80-3e3c-48e6-999e-f608e5c2bc77","ownedRelatedElement":[{"id":"bfe3c9ea-e4f5-4c9c-97fc-4e36fecd579c","eClass":"sysml:MetadataDefinition","data":{"declaredName":"VerificationLink","elementId":"9da287e9-765d-4a92-8eb4-1fe77c2dfd56","ownedRelationship":[{"id":"c41c983d-a54b-4045-9d96-7f90ae1712ff","eClass":"sysml:OwningMembership","data":{"elementId":"606f1ae9-bad1-4603-953f-11b420e554c5","ownedRelatedElement":[{"id":"908a5267-7b91-4497-a552-53381772c16f","eClass":"sysml:Documentation","data":{"elementId":"eef5cf64-9ec0-4256-8ccc-587311345584","body":"* Stand-in for the standard \"verify\" relationship (RequirementVerificationMembership),\n         * applied on the RequirementUsage being verified rather than on the case, pointing at\n         * the VerificationCaseUsage that verifies it.\n         *\n         * This exists only because, as of the generated metamodel this project builds against,\n         * VerificationCaseUsage.getVerifiedRequirement() unconditionally returns an empty list\n         * and RequirementVerificationMembershipImpl.basicGetOwnedRequirement()/\n         * basicGetVerifiedRequirement() are literal unimplemented stubs (`// TODO: implement\n         * this method`, returning null) -- confirmed by reading\n         * backend/metamodel/.../impl/VerificationCaseUsageImpl.java and\n         * .../RequirementVerificationMembershipImpl.java directly. The standard relationship\n         * cannot be read back (and, empirically, \"verify req1;\" does not even get authored by\n         * the bundled syside-cli), so the requirements tables verification-procedure-ID column\n         * (docs/plan.md, task 3a) uses this instead. It is a workaround, not a first-class\n         * SysML v2 concept: a model exported with this metadata will not be recognized as\n         * having a \"verify\" relationship by another SysML v2 tool. Retire this in favor of the\n         * standard relationship once the upstream metamodel bug is fixed."}}]}},{"id":"5b79b4f9-4562-4f7d-b55e-4af09385d1a4","eClass":"sysml:FeatureMembership","data":{"elementId":"bb3b421c-b775-47c5-927b-037cce0505fc","ownedRelatedElement":[{"id":"b39afbab-f249-4629-acfa-170ea8699608","eClass":"sysml:ReferenceUsage","data":{"declaredName":"verificationCase","elementId":"5bd61858-e458-4a54-98ea-61eca87295d1","ownedRelationship":[{"id":"4e04202d-939f-4ad4-8087-907ad9114726","eClass":"sysml:FeatureTyping","data":{"elementId":"d0073e2c-47e1-4d97-9ef0-e71cd335f986","type":"sysml:VerificationCaseDefinition sysmllibrary:///d5c9b931-6fc0-397f-b21d-f50d6d350559#47f5248d-9140-50c8-b28c-16d68d573621","typedFeature":"5bd61858-e458-4a54-98ea-61eca87295d1"}}],"isComposite":true}}]}},{"id":"e92c569c-1101-4325-9b4c-dbb4e1216c1f","eClass":"sysml:FeatureMembership","data":{"elementId":"b53b526c-d2b8-48f9-acac-2a281305f7a7","ownedRelatedElement":[{"id":"113bc4bf-2cf3-4117-91a4-a369d1445a8c","eClass":"sysml:ReferenceUsage","data":{"elementId":"80e35200-62fd-424e-aa34-892a282d5202","ownedRelationship":[{"id":"faf3d9ab-861a-4022-a070-417648d35fd2","eClass":"sysml:Subsetting","data":{"elementId":"2c2725a6-5b5d-43cc-a18b-35ad4e925c36","subsettedFeature":"sysml:Feature kermllibrary:///eed035b6-25dc-32cd-8fdf-233aa595e17a#619988f5-49d9-5c7e-9785-f3edd5b4d3fd","subsettingFeature":"80e35200-62fd-424e-aa34-892a282d5202"}},{"id":"04e7c4e0-1e3a-4264-b16f-21fea052b662","eClass":"sysml:FeatureTyping","data":{"elementId":"70143443-b487-4c6f-9265-78aef22f57c2","type":"sysml:MetadataDefinition sysmllibrary:///389615e8-f636-3405-928f-411d874ba837#e4cd605b-282e-5367-9ef2-5ffa1685c67b","typedFeature":"80e35200-62fd-424e-aa34-892a282d5202"}}],"isComposite":true}}]}}]}}]}}],"isStandard":true}}]}}]}}]}