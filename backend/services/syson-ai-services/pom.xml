<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.syson</groupId>
		<artifactId>syson</artifactId>
		<version>2026.7.4</version>
		<relativePath>../../../pom.xml</relativePath>
	</parent>
	<groupId>org.eclipse.syson</groupId>
	<artifactId>syson-ai-services</artifactId>
	<version>2026.7.4</version>
	<name>syson-ai-services</name>
	<description>SysON AI Modeling Assistant Services (proposal persistence, model-scope serialization, generation pipeline)</description>

	<dependencies>
		<!-- Main: inference goes to the Anthropic API through the official Java SDK.
		     Version is pinned here rather than in the root pom's dependencyManagement to keep
		     this fork's footprint in upstream files as small as possible. -->
		<dependency>
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java</artifactId>
			<version>2.34.0</version>
		</dependency>
		<!-- Main: model-scope serialization walks Element and renders it with
		     SysMLElementSerializer; ElementUtil tells standard-library elements apart. -->
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-sysml-metamodel</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-sysml-metamodel-services</artifactId>
		</dependency>
		<!-- Proposals are persisted with Spring Data JDBC, the same persistence style the
		     Sirius Web platform itself uses (see org.eclipse.sirius.web.domain). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jdbc</artifactId>
		</dependency>
		<!-- Our own schema is migrated by a changelog of our own; see
		     SysONAiDatabaseMigration for why it is deliberately not a SpringLiquibase bean. -->
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
		</dependency>

		<!-- Main: generated SysML is validated by parsing it, so the parser is a runtime
		     dependency and not just a test fixture. -->
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-sysml-import</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-application-configuration</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Brings ArchUnit and AbstractCodingRulesTests, the architecture-test pattern every
		     module in this fork mirrors. -->
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-tests</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- The proposal store is only meaningfully tested against a real PostgreSQL: the
		     changelog, the Spring Data JDBC mapping and the child-collection cascade are all
		     things an in-memory substitute would not exercise faithfully. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<configuration>
					<configLocation>../../releng/syson-resources/checkstyle/CheckstyleConfiguration.xml</configLocation>
					<sourceDirectories>
						<sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
						<sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
					</sourceDirectories>
					<failsOnError>true</failsOnError>
					<consoleOutput>true</consoleOutput>
				</configuration>
				<executions>
					<execution>
						<id>validate</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
