<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="002-add-seed-elements" author="syson">
        <comment>
            Records which elements a proposal was generated from.

            Without it, resuming an unreviewed proposal could offer a reviewer candidates that were
            derived from a different element than the one they have open - and accepting one would
            apply it to the element in front of them. For a task that replaces a narrative, that
            means overwriting the wrong document.
        </comment>
        <addColumn tableName="ai_proposal">
            <column name="seed_element_ids" type="TEXT" defaultValue="">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
