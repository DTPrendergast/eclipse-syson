extend type EditingContext {
  pendingAiProposals: [AiProposal!]!
}

type AiProposal {
  id: String!
  taskKind: String!
  seedElementIds: [String!]!
  prompt: String!
  modelId: String!
  createdBy: String!
  createdOn: String!
  items: [AiProposalItem!]!
}

type AiProposalItem {
  id: String!
  label: String!
  sysmlFragment: String!
  status: String!
}

extend type Mutation {
  generateAiProposal(input: GenerateAiProposalInput!): GenerateAiProposalPayload!
  applyAiProposalItem(input: ApplyAiProposalItemInput!): ApplyAiProposalItemPayload!
  rejectAiProposalItem(input: RejectAiProposalItemInput!): RejectAiProposalItemPayload!
}

input GenerateAiProposalInput {
  id: ID!
  editingContextId: String!
  elementIds: [String!]!
  task: String!
  instruction: String!
}

type GenerateAiProposalSuccessPayload {
  id: ID!
  proposalId: String
  candidateCount: Int!
  items: [ProposedItem!]!
  problems: [String!]!
}

type ProposedItem {
  id: String!
  label: String!
  sysmlFragment: String!
}

union GenerateAiProposalPayload = ErrorPayload | GenerateAiProposalSuccessPayload

input ApplyAiProposalItemInput {
  id: ID!
  editingContextId: String!
  proposalId: String!
  itemId: String!
  parentElementId: String!
}

union ApplyAiProposalItemPayload = ErrorPayload | SuccessPayload

input RejectAiProposalItemInput {
  id: ID!
  proposalId: String!
  itemId: String!
}

union RejectAiProposalItemPayload = ErrorPayload | SuccessPayload
